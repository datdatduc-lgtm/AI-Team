{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/capability-requirement.schema.json",
  "title": "CapabilityRequirementPayload",
  "description": "Capability requirement required to execute a goal or action",
  "type": "object",
  "required": [
    "schemaVersion",
    "requirementId",
    "capabilityId",
    "description",
    "resolved",
    "resolutionType"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "requirementId": {
      "type": "string",
      "minLength": 1
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "resolved": {
      "type": "boolean"
    },
    "resolutionType": {
      "type": "string",
      "enum": ["AUTOMATIC", "USER_APPROVAL", "HOST_PERMISSION", "UNSUPPORTED"]
    },
    "resolvedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
