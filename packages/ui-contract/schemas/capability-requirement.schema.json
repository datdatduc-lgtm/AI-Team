{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/capability-requirement.schema.json",
  "title": "CapabilityRequirementPayload",
  "description": "Capability requirement required to execute a goal or action",
  "type": "object",
  "required": [
    "schemaVersion",
    "requirementId",
    "capabilityId",
    "capabilityName",
    "category",
    "description",
    "status",
    "resolutionType",
    "alternatives",
    "recommendedActions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "requirementId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "capabilityId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "capabilityName": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "$ref": "common.schema.json#/$defs/CapabilityCategory"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "$ref": "common.schema.json#/$defs/CapabilityStatus"
    },
    "resolutionType": {
      "type": "string",
      "enum": ["AUTOMATIC", "USER_APPROVAL", "HOST_PERMISSION", "UNSUPPORTED"]
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/RecommendedActionRef"
      }
    },
    "resolvedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    }
  },
  "additionalProperties": false
}

