{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/route-state.schema.json",
  "title": "RouteStatePayload",
  "description": "Host and application route focus and view state",
  "type": "object",
  "required": [
    "schemaVersion",
    "routeId",
    "routeName",
    "semanticState",
    "targetAgentId",
    "capturedTargetName",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "routeId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "routeName": {
      "type": "string",
      "minLength": 1
    },
    "semanticState": {
      "$ref": "common.schema.json#/$defs/RouteSemanticState"
    },
    "targetAgentId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "capturedTargetName": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    }
  },
  "additionalProperties": false
}

