{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/ui-action-envelope.schema.json",
  "title": "UIActionEnvelope",
  "description": "Envelope for all actions dispatched from UI to Core in AI-Team v1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "actionId",
    "operationId",
    "intent",
    "projectId",
    "expectedStateRevision",
    "parameters"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "actionId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/EntityId",
      "description": "Identifies ONE logical operation. Must be reused across retries (timeout, reconnect, lost ACK)."
    },
    "intent": {
      "$ref": "common.schema.json#/$defs/UIActionIntent"
    },
    "projectId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "sessionId": {
      "type": ["string", "null"]
    },
    "goalId": {
      "type": ["string", "null"]
    },
    "expectedStateRevision": {
      "$ref": "common.schema.json#/$defs/StateRevision"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/TargetRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

