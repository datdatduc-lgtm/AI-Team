{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/recommended-action.schema.json",
  "title": "RecommendedActionPayload",
  "description": "Proactive action recommendation suggested by Core for UI execution",
  "type": "object",
  "required": [
    "schemaVersion",
    "recommendationId",
    "actionCode",
    "targetId",
    "labelKey",
    "title",
    "intent",
    "reason",
    "confidenceScore",
    "requiresApproval",
    "payloadParameters"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "recommendationId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "actionCode": {
      "type": "string",
      "minLength": 1
    },
    "targetId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "labelKey": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "$ref": "common.schema.json#/$defs/UIActionIntent"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "confidenceScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requiresApproval": {
      "type": "boolean"
    },
    "payloadParameters": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

