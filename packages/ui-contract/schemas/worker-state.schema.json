{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/worker-state.schema.json",
  "title": "WorkerStatePayload",
  "description": "Managed local execution runtime state (independent from Agent logical persona)",
  "type": "object",
  "required": [
    "schemaVersion",
    "workerId",
    "displayName",
    "ownedByAgentId",
    "workState",
    "supportsPauseSafepoint",
    "ownership",
    "stateRevision",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "workerId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "ownedByAgentId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "currentTaskSummary": {
      "type": "string"
    },
    "workState": {
      "$ref": "common.schema.json#/$defs/WorkerWorkState"
    },
    "supportsPauseSafepoint": {
      "type": "boolean"
    },
    "ownership": {
      "$ref": "common.schema.json#/$defs/Ownership"
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "cpuPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "memoryMb": {
          "type": "number",
          "minimum": 0
        },
        "uptimeSeconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "stateRevision": {
      "$ref": "common.schema.json#/$defs/StateRevision"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    }
  },
  "additionalProperties": false
}

