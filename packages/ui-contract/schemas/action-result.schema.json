{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/action-result.schema.json",
  "title": "ActionResultPayload",
  "description": "Result envelope returned synchronously or via ACK for a UIActionEnvelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "actionId",
    "operationId",
    "status",
    "currentStateRevision",
    "message",
    "emittedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "actionId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "operationId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/ActionResultStatus"
    },
    "operationState": {
      "$ref": "common.schema.json#/$defs/OperationState"
    },
    "currentStateRevision": {
      "$ref": "common.schema.json#/$defs/StateRevision"
    },
    "message": {
      "type": "string"
    },
    "rejectionReason": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "emittedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    }
  },
  "additionalProperties": false
}

