{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/session-state.schema.json",
  "title": "SessionStatePayload",
  "description": "Session aggregate state (independent from Goal state)",
  "type": "object",
  "required": [
    "schemaVersion",
    "sessionId",
    "projectId",
    "status",
    "selectedAgentIds",
    "stateRevision",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "sessionId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "projectId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/SessionStatus"
    },
    "activeGoalId": {
      "type": ["string", "null"]
    },
    "selectedAgentIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/EntityId"
      }
    },
    "stateRevision": {
      "$ref": "common.schema.json#/$defs/StateRevision"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    }
  },
  "additionalProperties": false
}

