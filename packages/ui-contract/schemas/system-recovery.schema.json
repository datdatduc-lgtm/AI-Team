{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/system-recovery.schema.json",
  "title": "SystemRecoveryPayload",
  "description": "System recovery state and guidance when recovery is needed",
  "type": "object",
  "required": [
    "schemaVersion",
    "recoveryId",
    "target",
    "status",
    "whatHappened",
    "whatAiTeamIsDoing",
    "whatUserShouldDo",
    "recommendedActions",
    "canAutoRecover",
    "initiatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "recoveryId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/TargetRef"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/RecoveryStatus"
    },
    "whatHappened": {
      "type": "string",
      "minLength": 1
    },
    "whatAiTeamIsDoing": {
      "type": "string",
      "minLength": 1
    },
    "whatUserShouldDo": {
      "type": "string",
      "minLength": 1
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/RecommendedActionRef"
      }
    },
    "canAutoRecover": {
      "type": "boolean"
    },
    "initiatedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    }
  },
  "additionalProperties": false
}

