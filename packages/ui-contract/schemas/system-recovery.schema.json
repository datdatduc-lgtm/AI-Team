{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/system-recovery.schema.json",
  "title": "SystemRecoveryPayload",
  "description": "System recovery state and guidance when recovery is needed",
  "type": "object",
  "required": [
    "schemaVersion",
    "target",
    "whatHappened",
    "whatAiTeamIsDoing",
    "whatUserShouldDo",
    "recoveryStatus",
    "recommendedActions"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/TargetRef"
    },
    "whatHappened": {
      "type": "string",
      "minLength": 1
    },
    "whatAiTeamIsDoing": {
      "type": "string",
      "minLength": 1
    },
    "whatUserShouldDo": {
      "type": "string",
      "minLength": 1
    },
    "recoveryStatus": {
      "$ref": "common.schema.json#/$defs/RecoveryStatus"
    },
    "attemptIndex": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "attemptLimit": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/RecommendedActionRef"
      }
    }
  },
  "additionalProperties": false
}

