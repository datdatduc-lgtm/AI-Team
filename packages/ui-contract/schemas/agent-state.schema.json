{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/agent-state.schema.json",
  "title": "AgentStatePayload",
  "description": "Logical AI team member state (independent from Worker managed execution runtime)",
  "type": "object",
  "required": [
    "schemaVersion",
    "agentId",
    "displayName",
    "agentType",
    "healthStatus",
    "statusSummary",
    "selectedForSession",
    "assignedToGoal",
    "sessionRole",
    "canContinueWithoutAgent",
    "userActionRequired",
    "recommendedActions",
    "stateRevision",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "agentId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "agentType": {
      "$ref": "common.schema.json#/$defs/AgentType"
    },
    "healthStatus": {
      "$ref": "common.schema.json#/$defs/AgentHealthStatus"
    },
    "statusSummary": {
      "type": "string"
    },
    "selectedForSession": {
      "type": "boolean"
    },
    "assignedToGoal": {
      "type": "boolean"
    },
    "sessionRole": {
      "type": "string",
      "minLength": 1
    },
    "goalRole": {
      "type": "string"
    },
    "canContinueWithoutAgent": {
      "type": "boolean"
    },
    "userActionRequired": {
      "type": "boolean"
    },
    "userActionPrompt": {
      "type": "string"
    },
    "recommendedActions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/RecommendedActionRef"
      }
    },
    "stateRevision": {
      "$ref": "common.schema.json#/$defs/StateRevision"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    }
  },
  "additionalProperties": false
}

