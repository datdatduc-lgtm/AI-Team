{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/goal-state.schema.json",
  "title": "GoalStatePayload",
  "description": "Goal aggregate state (independent from Session state)",
  "type": "object",
  "required": [
    "schemaVersion",
    "goalId",
    "sessionId",
    "projectId",
    "title",
    "goalState",
    "summaryText",
    "completedTaskCount",
    "totalTaskCount",
    "assignedAgentIds",
    "stateRevision",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "goalId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "sessionId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "projectId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "goalState": {
      "$ref": "common.schema.json#/$defs/GoalStatus"
    },
    "summaryText": {
      "type": "string"
    },
    "completedTaskCount": {
      "type": "integer",
      "minimum": 0
    },
    "totalTaskCount": {
      "type": "integer",
      "minimum": 0
    },
    "assignedAgentIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/EntityId"
      }
    },
    "stateRevision": {
      "$ref": "common.schema.json#/$defs/StateRevision"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    }
  },
  "additionalProperties": false
}

