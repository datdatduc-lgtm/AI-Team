{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/core-event-envelope.schema.json",
  "title": "CoreEventEnvelope",
  "description": "Envelope for all events dispatched by Core to UI in AI-Team v1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "emittedAt",
    "projectId",
    "stateRevision",
    "sequence",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "emittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string"
    },
    "goalId": {
      "type": "string"
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
