{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/core-event-envelope.schema.json",
  "title": "CoreEventEnvelope",
  "description": "Envelope for all events dispatched by Core to UI in AI-Team v1.0.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "emittedAt",
    "projectId",
    "stateRevision",
    "sequence",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "eventId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "emittedAt": {
      "$ref": "common.schema.json#/$defs/IsoTimestamp"
    },
    "projectId": {
      "$ref": "common.schema.json#/$defs/EntityId"
    },
    "sessionId": {
      "type": ["string", "null"]
    },
    "goalId": {
      "type": ["string", "null"]
    },
    "stateRevision": {
      "$ref": "common.schema.json#/$defs/StateRevision"
    },
    "sequence": {
      "$ref": "common.schema.json#/$defs/SequenceNumber"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}

