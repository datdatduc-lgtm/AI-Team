{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-team.dev/schemas/v1/common.schema.json",
  "title": "CommonTypes",
  "description": "Common primitive definitions and enums for AI-Team UI Data Contract v1.0.0",
  "type": "object",
  "$defs": {
    "SchemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Strict UI Data Contract v1.0.0 schema version"
    },
    "EntityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "IsoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "StateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "SequenceNumber": {
      "type": "integer",
      "minimum": 0
    },
    "Ownership": {
      "type": "string",
      "enum": ["OWNED", "BORROWED", "FOREIGN"],
      "description": "Strict worker ownership classification"
    },
    "AgentHealthStatus": {
      "type": "string",
      "enum": ["HEALTHY", "DEGRADED", "DISCONNECTED", "OFF"],
      "description": "Agent health status strictly decoupled from worker execution state"
    },
    "WorkerWorkState": {
      "type": "string",
      "enum": [
        "IDLE",
        "RUNNING",
        "PAUSING_SAFEPOINT",
        "PAUSED",
        "RECOVERING",
        "STUCK",
        "TERMINATED"
      ],
      "description": "Worker execution state strictly decoupled from agent health status"
    },
    "UIActionIntent": {
      "type": "string",
      "enum": [
        "INITIALIZE_AI_TEAM",
        "SET_SESSION_TEAM",
        "CHECK_SESSION_READINESS",
        "CAPTURE_FOCUSED_ROUTE",
        "SUBMIT_GOAL",
        "ENABLE_CAPABILITY",
        "RESOLVE_CAPABILITY_REQUIREMENT",
        "START_GOAL_EXECUTION",
        "STOP_CURRENT_GOAL",
        "PAUSE_WORKER_SAFEPOINT",
        "EXECUTE_RECOMMENDED_ACTION",
        "TERMINATE_SESSION"
      ],
      "description": "Baseline UI action intents"
    },
    "ActionResultStatus": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "REQUIRES_APPROVAL",
        "CONFLICT",
        "UNSUPPORTED"
      ],
      "description": "Action admission result status"
    },
    "OperationState": {
      "type": "string",
      "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED"],
      "description": "Long-running operation execution state"
    },
    "SessionStatus": {
      "type": "string",
      "enum": [
        "OFF",
        "STARTING",
        "CHECKING_READINESS",
        "READY",
        "READY_DEGRADED",
        "BLOCKED",
        "ENDING"
      ],
      "description": "Session lifecycle state"
    },
    "GoalStatus": {
      "type": "string",
      "enum": [
        "INTAKE",
        "RESOLVING_CAPABILITIES",
        "READY",
        "RUNNING",
        "PAUSING",
        "PAUSED",
        "RECOVERING",
        "WAITING_FOR_USER",
        "BLOCKED",
        "FAILED",
        "COMPLETED"
      ],
      "description": "Goal lifecycle state"
    },
    "CapabilityStatus": {
      "type": "string",
      "enum": ["AVAILABLE", "DISABLED", "UNCONFIGURED", "MISSING", "INCOMPATIBLE"],
      "description": "Capability availability status"
    },
    "CapabilityCategory": {
      "type": "string",
      "enum": ["HOST", "MODEL", "TOOL", "INTEGRATION", "SYSTEM"],
      "description": "Capability classification category"
    },
    "RouteSemanticState": {
      "type": "string",
      "enum": [
        "CONFIGURED",
        "VERIFYING",
        "READY",
        "AUTH_REQUIRED",
        "WRONG_CONVERSATION",
        "MISSING",
        "BROKEN"
      ],
      "description": "Semantic route state"
    },
    "RecoveryStatus": {
      "type": "string",
      "enum": ["RECOVERING", "WAITING_FOR_USER", "BLOCKED", "FAILED"],
      "description": "System recovery status"
    },
    "TargetRef": {
      "type": "object",
      "description": "Target entity reference for actions, recovery, and routing",
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["AGENT", "WORKER", "CAPABILITY", "ROUTE", "GOAL"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "RecommendedActionRef": {
      "type": "object",
      "description": "Recommended action definition",
      "required": ["actionCode", "targetId", "labelKey", "requiresApproval"],
      "properties": {
        "actionCode": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "labelKey": {
          "type": "string",
          "minLength": 1
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "payloadParameters": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}

